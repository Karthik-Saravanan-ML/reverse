# ─────────────────────────────────────────────────────────────────────────────
# AI-Native CRM — Backend Environment Variables
#
# Copy this file to .env and fill in real values.
# NEVER commit .env with real credentials to version control.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/crm_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# JWT — must be at least 64 characters (256-bit secret)
JWT_SECRET=replace_with_a_long_random_string_of_at_least_64_characters_here_change_this
JWT_EXPIRATION=86400000   # 24 hours in milliseconds

# Server
SERVER_PORT=8080
